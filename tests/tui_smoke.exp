#!/usr/bin/expect -f
# Drives the TUI in a pseudo-terminal at 80x24 (with --theme high-contrast):
# add a server through the form, open the detail view (unreachable TEST-NET
# host), help (shows the theme), quit; then check that the terminal settings
# were restored. Two more runs show a grouped list with and without group
# headings (group_headings); the first also toggles them with t (no effect
# in the detail view; on the list only for the session, settings.conf stays
# the same). The last run replaces ssh with a local `sh -s` and docker with
# the test fixtures: Docker section in the detail view, the read-only Docker
# view under m, and a server without docker (no module offered); smartctl
# answers from the drive fixtures (warning in the list, Drives section).
# Usage: tests/tui_smoke.exp <config-dir>

set timeout 15
set cfg [lindex $argv 0]
set root [file dirname [file dirname [file normalize [info script]]]]
set stty_file "$cfg.stty"
set t0 [clock milliseconds]
log_user 0

proc fail {msg} { puts "FAIL: $msg"; exit 1 }

# Waits for a regex on screen; prints the step with elapsed time.
proc want {pattern step} {
    global t0
    expect {
        -re $pattern { puts [format "  ok    %-38s %6d ms" $step [expr {[clock milliseconds] - $t0}]] }
        timeout { fail "$step (no '$pattern' on screen)" }
        eof { fail "$step (program exited)" }
    }
}

set env(TERM) xterm-256color
set stty_init "rows 24 columns 80"
spawn -noecho bash -c "stty -g > '$stty_file.before'; '$root/scat' --config-dir '$cfg' --theme high-contrast; echo EXIT=\$?; stty -g > '$stty_file.after'"

want "PING" "PING column in the list header"
want "TEMP" "TEMP column in the list header"
want "No servers yet" "empty server list shown"
send "a"
want "Add server" "add form opened"
send "\r"
send "web1\r"
want "Host alias from" "name accepted, moved to Host"
send "\r"
send "192.0.2.1\r"
want "Default: 22" "host accepted, moved to Port"
send "s"
want "Saved 'web1'" "server saved"
# STATUS is 18 wide at 80 columns: "connection timed …".
want "connection timed" "unreachable host reported in list"
send "\r"
want "Monitoring uses BatchMode" "detail view opened"
want "Press .s. to connect" "detail shows error and hints"
send "\033?"
want "keyboard reference" "Esc back + help (typeahead kept)"
want "theme high-contrast" "--theme applied (shown in help)"
send "q"
want "PING" "help closed, back on list"
send "q"
want "EXIT=0" "quit with status 0"
expect eof

if {![file exists "$stty_file.after"]} { fail "shell did not finish" }
set f [open "$stty_file.before"]; set before [string trim [read $f]]; close $f
set f [open "$stty_file.after"]; set after [string trim [read $f]]; close $f
# PENDIN (0x20000000) is set by the macOS tty driver itself whenever ICANON
# is switched back on, and cleared on the next read; ignore it.
proc mask_pendin {s} {
    if {[regexp {lflag=([0-9a-f]+)} $s -> hex]} {
        scan $hex %x n
        set v [format %x [expr {$n & ~0x20000000}]]
        regsub {lflag=[0-9a-f]+} $s "lflag=$v" s
    }
    return $s
}
if {[mask_pendin $before] ne [mask_pendin $after]} {
    fail "terminal settings not restored:\n  before $before\n  after  $after"
}
puts "  ok    terminal settings restored"
set f [open "$cfg/servers.conf"]; set conf [read $f]; close $f
if {![string match "*\\\[web1\\\]*host = 192.0.2.1*" $conf]} { fail "servers.conf missing web1" }
puts "  ok    servers.conf contains web1"

# Grouped list from a prepared config; $headings is the group_headings value.
proc grouped_list {dir headings} {
    global root spawn_id
    file mkdir $dir
    set f [open "$dir/servers.conf" w]
    puts $f "\[alpha\]\nhost = 192.0.2.10\ngroup = prod\n\n\[beta\]\nhost = 192.0.2.11\ngroup = test"
    close $f
    set f [open "$dir/settings.conf" w]
    puts $f "\[settings\]\ngroup_headings = $headings\nlist_refresh = 3600"
    close $f
    spawn -noecho $root/scat --config-dir $dir
}
proc quit_list {step} {
    send "q"
    expect {
        eof { puts [format "  ok    %-38s" $step] }
        timeout { fail "$step (did not quit)" }
    }
}

proc settings_text {dir} {
    set f [open "$dir/settings.conf"]; set c [read $f]; close $f
    return $c
}

grouped_list "$cfg-groups-on" 1
set settings0 [settings_text "$cfg-groups-on"]
want {(──|--) prod (──|--)} "group headings shown (group_headings = 1)"
want {(──|--) test (──|--)} "second group heading shown"
send "\r"
want "processes" "detail view of a grouped server"
send "t"
send "\033"
want "PING" "back on the list after t in the detail"
if {[regexp {Group headings} $expect_out(buffer)]} { fail "t in the detail view toggled the headings" }
puts [format "  ok    %-38s" "t in the detail view: no effect"]
send "t"
want "Group headings off" "t on the list: headings off"
if {[settings_text "$cfg-groups-on"] ne $settings0} { fail "t changed settings.conf" }
puts [format "  ok    %-38s" "settings.conf unchanged after t"]
send "t"
want {(──|--) prod (──|--)} "t again: heading drawn again"
want "Group headings on" "t again: message"
if {[settings_text "$cfg-groups-on"] ne $settings0} { fail "second t changed settings.conf" }
puts [format "  ok    %-38s" "settings.conf unchanged after 2nd t"]
send "f"
want "Temperature in .F" "f: temperature unit F"
send "f"
want "Temperature in .C" "f again: back to C"
if {[settings_text "$cfg-groups-on"] ne $settings0} { fail "f changed settings.conf" }
puts [format "  ok    %-38s" "settings.conf unchanged after f"]
quit_list "quit grouped list"

grouped_list "$cfg-groups-off" 0
want "beta" "grouped list without headings drawn"
if {[regexp { prod (──|--)} $expect_out(buffer)]} { fail "heading shown although group_headings = 0" }
puts [format "  ok    %-38s" "no headings with group_headings = 0"]
quit_list "quit list without headings"

# Docker: ssh runs the scripts locally; only host dock.invalid finds docker.
set dir "$cfg-docker"
set bin "$dir/bin"
file mkdir "$bin/docker-bin"
set f [open "$dir/servers.conf" w]
puts $f "\[dock\]\nhost = dock.invalid\n\n\[plain\]\nhost = plain.invalid"
close $f
set f [open "$dir/settings.conf" w]
puts $f "\[settings\]\nping = 0\nlist_refresh = 3600"
close $f
set f [open "$bin/ssh" w]
puts $f [string map [list @BIN@ $bin] {#!/bin/sh
for a; do [ "$a" = -O ] && exit 0; done
host= prev=
for a; do [ "$prev" = -- ] && host=$a; prev=$a; done
[ "$host" = dock.invalid ] && PATH=@BIN@/docker-bin:$PATH && export PATH
exec sh -s}]
close $f
set f [open "$bin/docker-bin/docker" w]
puts $f [string map [list @FX@ "$root/tests/fixtures"] {#!/bin/sh
case $1 in
    ps) cat @FX@/docker-ps.jsonl ;;
    stats) cat @FX@/docker-stats.jsonl ;;
    *) exit 2 ;;
esac}]
close $f
# Drives: smartctl and sudo -n for dock.invalid, answering from the fixtures.
set f [open "$bin/docker-bin/smartctl" w]
puts $f [string map [list @FX@ "$root/tests/fixtures/drives"] {#!/bin/sh
[ "$1" = --scan ] && { printf '/dev/sda -d scsi\n/dev/sdb -d scsi\n'; exit 0; }
[ "$1" = -n ] && shift 2
case $2 in
    /dev/sda) cat @FX@/sata-ok.txt ;;
    /dev/sdb) cat @FX@/sata-pending.txt ;;
esac}]
close $f
set f [open "$bin/docker-bin/sudo" w]
puts $f {#!/bin/sh
[ "$1" = -n ] && shift
exec "$@"}
close $f
file attributes "$bin/docker-bin/smartctl" -permissions 0755
file attributes "$bin/docker-bin/sudo" -permissions 0755
file attributes "$bin/ssh" -permissions 0755
file attributes "$bin/docker-bin/docker" -permissions 0755
set env(PATH) "$bin:$env(PATH)"
spawn -noecho $root/scat --config-dir $dir
want "plain" "list with dock and plain"
want "sdb: 8 pending" "list: drive warning instead of the OS"
send "\r"
want "online" "detail of dock (collector via local sh)"
want {Drives.{0,40}2 drives} "detail: Drives heading after Disks"
want {sdb .{0,60}WARN} "detail: drive row with WARN"
# The Docker section is below the fold at 80x24; give the query a moment,
# then jump to the end.
after 1500
send "G"
# Styles change inside these rows, so escape sequences may sit between words.
want {Docker.{0,30}4 running / 5 total} "Docker heading (scrolled to the end)"
# The rows arrived after the first G; jump to the end again.
send "G"
want {worker +97.0 +20.0 +786M.{0,20}Up 5 days \(unhealthy\)} "detail: container in the process grid"
send "m"
want {Docker containers \(read only\)} "module menu offers Docker"
send "\r"
want "4/5 running" "Docker view: counts in the header"
want "NAME +IMAGE +STATUS +HEALTH +CPU% +MEM" "Docker view: column header"
want {unhealthy.{0,20}97.0 +786M} "Docker view: stats loaded"
send "x"
send "\033"
want "Docker containers" "Esc back to the module menu"
send "\033"
send "\033"
want "PING|plain" "back on the list"
send "j"
send "\r"
want "online" "detail of plain"
send "m"
want "No modules for plain: Docker: no docker command on plain" "no Docker module without docker"
send "\033"
quit_list "quit after the Docker run"
puts "PASS: TUI smoke test"
